# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# ID общего чата (ты + Даня). Узнать: добавить бота в чат и написать /chatid
CHAT_ID=
# Секрет для вебхука Тильды: URL будет https://<host>/tilda?token=<TILDA_TOKEN>
TILDA_TOKEN=change-me
# Порт HTTP-сервера для приёма заказов
PORT=8080
# Комиссия эквайринга в процентах (вычитается из выручки при расчёте чистой)
ACQUIRING_PERCENT=3.5
# Налог с выручки, % (УСН 6% — поставь 6). 0 = не учитывать
TAX_PERCENT=0
# Доля Дани от прибыли бренда, %
DANE_SHARE_PERCENT=50
# Чьи реакции на карточку заказа значат «отдал Дане». Узнать свой id: /chatid в чате.
# Пусто = реакция любого участника. Несколько — через запятую.
PAYER_IDS=
# Через сколько дней неотправленный заказ считается просроченным
SHIP_DEADLINE_DAYS=3
# Время ежедневного напоминания о неотправленных (часы по Москве), пусто = выключено
REMINDER_HOUR=11

# Google Sheets (онлайн-таблица). Пусто = таблица выключена
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

DB_PATH=data/orders.db
PRODUCTS_FILE=products.yaml
