# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Имя бота в чатах (пусто = не трогать). Юзернейм @splitfinance_bot так не поменять.
BOT_NAME=Заказы
# ID общего чата. Обычно пусто: бот запоминает чат по команде /setup
CHAT_ID=
# Секрет для вебхука Тильды: URL будет https://<host>/tilda?token=<TILDA_TOKEN>
TILDA_TOKEN=change-me
# Порт HTTP-сервера для приёма заказов
PORT=8080
# Откуда пускать на этот порт: 127.0.0.1 — только nginx этого сервера,
# 0.0.0.0 — если /tilda пересылает nginx другого сервера (install.sh ставит сам)
BIND=127.0.0.1
# Как Тильда достучится до бота (заполняет install.sh): nginx | caddy | relay и https-домен
PUBLIC_MODE=
PUBLIC_DOMAIN=
# caddy — поднять Caddy с автоматическим https (только для PUBLIC_MODE=caddy)
COMPOSE_PROFILES=
# Комиссия, если способ оплаты в заказе не распознан, %
ACQUIRING_PERCENT=3.5
# Налог с выручки, % (УСН 6% — поставь 6). 0 = не учитывать
TAX_PERCENT=0
# Доля Дани от прибыли бренда, %
DANE_SHARE_PERCENT=50
# Чьи реакции на карточку заказа значат «отдал Дане». Обычно пусто: /setup добавляет того, кто его написал.
# Если пусто и /setup не делали — считается реакция любого участника. Несколько — через запятую.
PAYER_IDS=
# Через сколько дней неотправленный заказ считается просроченным
SHIP_DEADLINE_DAYS=3
# Время ежедневного напоминания о неотправленных (часы по Москве), пусто = выключено
REMINDER_HOUR=11

# Google Sheets (онлайн-таблица). Пусто = таблица выключена
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

DB_PATH=data/orders.db
PRODUCTS_FILE=products.yaml
